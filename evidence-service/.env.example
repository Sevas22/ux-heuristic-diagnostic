PORT=4100
# Secreto compartido con Supabase (EVIDENCE_SERVICE_KEY). Si se deja vacío el endpoint queda
# sin protección — solo aceptable en desarrollo local.
EVIDENCE_SERVICE_KEY=changeme
# URL pública por la que el navegador del usuario y Supabase alcanzan este servicio.
# En el VPS, detrás de nginx con HTTPS: https://evidencia.tudominio.com
PUBLIC_BASE_URL=http://localhost:4100
