# Estas se configuran como Environment Variables en el proyecto de Vercel (no se leen desde
# archivo en producción — .env solo sirve si corrés `vercel dev` localmente).

# Secreto compartido con Supabase. Si se deja vacío el endpoint queda sin protección —
# solo aceptable en desarrollo local.
EVIDENCE_SERVICE_KEY=changeme

# Mismas credenciales que ya usa el resto del proyecto en Supabase — necesarias acá para
# poder subir los screenshots al bucket de Storage. SUPABASE_SERVICE_ROLE_KEY es un secreto
# de alto privilegio (salta las RLS): no lo expongas ni lo commitees.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=changeme
