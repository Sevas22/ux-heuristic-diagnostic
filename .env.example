# Frontend (Vite) — estas son públicas, van en el bundle del navegador.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# ---------------------------------------------------------------------------
# Las variables de abajo NO van en este archivo en producción.
# Son secretos de las Edge Functions: se configuran con
#   supabase secrets set NOMBRE=valor
# o desde el dashboard de Supabase (Project Settings > Edge Functions > Secrets).
# Se listan aquí solo como referencia de lo que necesita cada función.
# ---------------------------------------------------------------------------

# Modo actual: SIN pasarela de pago. generate-report acepta submissions en
# estado 'draft' directamente. Para reactivar Stripe más adelante: quita este
# secreto (o ponlo en "false") y vuelve a conectar create-checkout-session en
# el frontend (src/pages/IntakeForm.tsx).
SKIP_PAYMENT=true

# generate-report (obligatorio: sin esto no se puede generar ningún informe)
GROQ_API_KEY=gsk_...

# Opcional: si se configura, generate-report envía un email con el enlace al informe.
# Sin esto, el usuario simplemente ve el informe en la página tras generarse.
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=diagnostico@tu-dominio.com

# Usadas por generate-report
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
SITE_URL=http://localhost:8081

# ---------------------------------------------------------------------------
# No necesarios por ahora (pasarela de pago desactivada). create-checkout-session
# y stripe-webhook ya están construidos y listos para cuando se reactive el cobro.
# ---------------------------------------------------------------------------
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID=
# STRIPE_CURRENCY=usd
# UX_REPORT_PRICE_CENTS=2900
